[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="SystemFont" id="Font_body"]
font_names = PackedStringArray("Segoe UI")
font_weight = 400

[sub_resource type="StyleBoxFlat" id="Button_normal"]
bg_color = Color(0.72, 0.59, 0.39, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_left = 7
corner_radius_bottom_right = 7
content_margin_left = 24.0
content_margin_top = 16.0
content_margin_right = 24.0
content_margin_bottom = 16.0

[sub_resource type="StyleBoxFlat" id="Button_hover"]
bg_color = Color(0.86, 0.73, 0.51, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_left = 7
corner_radius_bottom_right = 7
content_margin_left = 24.0
content_margin_top = 16.0
content_margin_right = 24.0
content_margin_bottom = 16.0

[sub_resource type="StyleBoxFlat" id="Button_focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.85, 0.64, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_left = 7
corner_radius_bottom_right = 7

[resource]
default_font = SubResource("Font_body")
default_font_size = 17
Label/colors/font_color = Color(0.88, 0.91, 0.92, 1)
Button/colors/font_color = Color(0.08, 0.11, 0.13, 1)
Button/colors/font_hover_color = Color(0.08, 0.11, 0.13, 1)
Button/colors/font_pressed_color = Color(0.08, 0.11, 0.13, 1)
Button/styles/normal = SubResource("Button_normal")
Button/styles/hover = SubResource("Button_hover")
Button/styles/pressed = SubResource("Button_normal")
Button/styles/focus = SubResource("Button_focus")
